PORT=4000
JWT_SECRET=replace-with-long-random-secret-at-least-32-characters
JWT_ISSUER=aura-family-backend
JWT_AUDIENCE=aura-family-clients
DATA_FILE=./data/db.json
# When set, the server uses Postgres instead of the local JSON file (required in production).
# Railway injects this automatically when you attach a Postgres service.
DATABASE_URL=
ADMIN_EMAIL=
# Optional comma-separated list. If set, this takes precedence over ADMIN_EMAIL.
ADMIN_EMAILS=
# Required comma-separated origins unless CORS_DISABLE_ORIGIN_CHECK=true.
# Example: https://aura.example.com,https://aura-family.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Dev-only override. Never set true in production.
CORS_DISABLE_ORIGIN_CHECK=false

# Rate limits
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=120
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=60